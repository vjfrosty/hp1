# Database (Neon via Vercel Marketplace; injected automatically on Vercel)
DATABASE_URL=

# Clerk (sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
ADMIN_USER_IDS=                 # optional, comma-separated Clerk user ids

# AI: OpenRouter, using Google Gemini models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash   # default when ai_settings has no model

# Storage (Cloudflare R2, server only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Map tiles
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_KEY=

# Vercel Schedules (cron) auth
CRON_SECRET=

# Only NEXT_PUBLIC_* variables may reach the browser.
