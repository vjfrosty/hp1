{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci --no-audit --no-fund",
  "buildCommand": "npm run db:migrate:deploy && cd ../.. && npx turbo build --filter=web",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
